[Unit]
Description=DriveSync SMB reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/drivesync --local /srv/dev/local --remote /mnt/synology/share --silent
WorkingDirectory=/srv/dev/local
Restart=no

[Install]
WantedBy=multi-user.target
