<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.drivesync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/drivesync</string>
    <string>--local</string>
    <string>/Users/youruser/dev/local</string>
    <string>--remote</string>
    <string>/Volumes/synology/share</string>
    <string>--silent</string>
  </array>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/drivesync.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/drivesync.err.log</string>
</dict>
</plist>
