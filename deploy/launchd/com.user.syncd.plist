<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.syncd</string>

  <!-- Replace the placeholder paths below with the real local root and
       mounted SMB/remote share for this machine before installing. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/syncd</string>
    <string>watch</string>
    <string>--local</string>
    <string>/Users/youruser/dev/local</string>
    <string>--remote</string>
    <string>/Volumes/synology/share</string>
    <string>--silent</string>
  </array>

  <key>KeepAlive</key>
  <true/>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/syncd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/syncd.err.log</string>
</dict>
</plist>
